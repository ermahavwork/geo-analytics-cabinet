# Локальный запуск API без Docker (база — из docker-compose.dev.yml на порту 5433).
DATABASE_OWNER_URL=postgres://cabinet_owner:owner-demo-password@127.0.0.1:5433/cabinet
DATABASE_URL=postgres://cabinet_app:app-demo-password@127.0.0.1:5433/cabinet
PORT=4000
GEO_API_URL=http://127.0.0.1:4000/api/mock-geo/v1
GEO_API_KEY=demo-geo-key
MOCK_GEO_FAIL_EVERY=4
SEED_DEMO=true
