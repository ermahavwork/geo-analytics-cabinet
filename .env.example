# Все переменные необязательны: без .env проект запускается на значениях по умолчанию.
# Скопируйте файл в .env, если нужно поменять порты или задать свои секреты.

# Порты на вашей машине
WEB_PORT=3000
API_PORT=4000

# Пароли ролей PostgreSQL (применяются при первом создании тома с данными)
DB_OWNER_PASSWORD=owner-demo-password
DB_APP_PASSWORD=app-demo-password

# Подпись сессий, не короче 32 символов. Если не задать, API создаёт случайный секрет
# при каждом старте (вход сбрасывается при перезапуске). Пример: openssl rand -hex 32
# JWT_SECRET=

# true, когда кабинет открыт по HTTPS
COOKIE_SECURE=false

# Часовой пояс, по которому отзывы раскладываются по дням
REPORT_TIMEZONE=Europe/Moscow

# Загружать вымышленные демо-данные в пустую базу
SEED_DEMO=true

# Внешний геосервис (по умолчанию — встроенная имитация)
GEO_API_URL=http://127.0.0.1:4000/api/mock-geo/v1
GEO_API_KEY=demo-geo-key
# Каждый N-й запрос к имитации отвечает 503, чтобы были видны повторные попытки (0 — без сбоев)
MOCK_GEO_FAIL_EVERY=4
